# SEC RAG System Environment Variables
# Copy this file to .env and fill in the values

# OpenAI API key for embeddings and vector store
OPENAI_API_KEY=sk-...

# Cohere API key for reranking (optional, will fall back to vector scores)
COHERE_API_KEY=...

# Cloudflare credentials (for R2 storage - optional)
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
